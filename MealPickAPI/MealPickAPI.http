@MealPickAPI_HostAddress = http://localhost:5125

@authToken = paste-your-access-token-here

POST {{MealPickAPI_HostAddress}}/ingredients
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "name": "Flour"
}

###

POST {{MealPickAPI_HostAddress}}/ingredients
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "name": "Flour"
}

