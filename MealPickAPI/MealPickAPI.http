POST {{MealPickAPI_HostAddress}}/recipes
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "title": "Vegetable pasta",
  "description": "A quick pasta recipe.",
  "instructions": [
    { "text": "Boil the pasta." },
    { "text": "Cook the vegetables." },
    { "text": "Combine and serve." }
  ],
  "categoryIds": [],
  "ingredients": [
    {
      "ingredientId": "replace-with-global-ingredient-id",
      "amount": 1,
      "unit": "tsp"
    }
  ]
}

###

POST {{MealPickAPI_HostAddress}}/recipes/replace-with-recipe-id/instructions
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "text": "Garnish with fresh basil."
}

